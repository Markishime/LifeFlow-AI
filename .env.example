# Copy to .env at the repository root for Docker Compose. Never commit real values.
ENVIRONMENT=development
AUTH_MODE=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# CLI-only local authentication: set AUTH_MODE=development and generate a random 32+ character secret.
DEV_JWT_SECRET=
DATABASE_URL=postgresql+psycopg://lifeflow:local-development-only@localhost:5432/lifeflow
POSTGRES_PASSWORD=local-development-only
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
STORAGE_MODE=s3
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=lifeflow-private
S3_ACCESS_KEY=lifeflow-local
S3_SECRET_KEY=local-storage-only-change-me
S3_REGION=us-east-1
MALWARE_SCANNER=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
NOTIFICATION_PROVIDER=local
EXPO_ACCESS_TOKEN=
OPENAI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=
AI_INPUT_PRICE_PER_MILLION=0
AI_OUTPUT_PRICE_PER_MILLION=0
RATE_LIMIT_PER_MINUTE=120
REVENUECAT_SECRET_KEY=
